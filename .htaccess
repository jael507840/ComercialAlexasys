# Alex@sys - configuración Apache
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquear acceso web directo a carpetas internas
    RewriteRule ^(config|Core|Models|Views|database|logs|tests|docs)(/|$) - [F,L]

    # Servir archivos y directorios existentes (assets, imagen)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Rutas amigables: /clientes -> index.php?ruta=clientes
    RewriteRule ^([a-z0-9-]+)/?$ index.php?ruta=$1 [QSA,L]
</IfModule>

# Proteger archivos sensibles
<FilesMatch "\.(sql|log|md|ini|env|bak)$">
    Require all denied
</FilesMatch>

# Las fotografías de la tienda usan la extensión .jfif (JPEG).
AddType image/jpeg .jfif

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
